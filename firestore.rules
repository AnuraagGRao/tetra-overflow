rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validScoreFields() {
      let d = request.resource.data;
      return d.score is int && d.score >= 0 && d.score <= 10000000
          && d.lines is int && d.lines >= 0 && d.lines <= 10000
          && d.level is int && d.level >= 1 && d.level <= 30
          && d.mode is string && d.mode.size() < 32
          && d.uid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && !('role' in request.resource.data)
        && !('admin' in request.resource.data);

      match /friends/{friendUid} {
        allow read: if isOwner(uid);
        allow create, update: if isSignedIn() && (isOwner(uid) || request.resource.data.uid == request.auth.uid);
        allow delete: if isOwner(uid);
      }

      match /coin_ledger/{entryId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /lobby_invites/{inviteId} {
        allow read: if isOwner(uid);
        allow create: if isSignedIn() && request.resource.data.fromUid == request.auth.uid;
        allow delete: if isOwner(uid);
        allow update: if false;
      }
    }

    match /public_profiles/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);
    }

    match /stats/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid);
    }

    match /scores/{scoreId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && validScoreFields();
      allow update, delete: if false;
    }

    match /story/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid);
    }

    match /lobbies/{code} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'waiting'
        && request.resource.data.players.size() == 1
        && request.resource.data.players[0].uid == request.auth.uid;

      allow update: if isSignedIn() && (
        resource.data.hostUid == request.auth.uid
        || (
          request.resource.data.hostUid == resource.data.hostUid
          && request.resource.data.status == resource.data.status
          && request.resource.data.code == resource.data.code
        )
      );

      allow delete: if isSignedIn() && resource.data.hostUid == request.auth.uid;
    }

    match /artwork_votes/{trackId} {
      allow read: if true;
      allow write: if isSignedIn()
        && request.resource.data.trackId == trackId
        && request.resource.data.up is int && request.resource.data.up >= 0
        && request.resource.data.down is int && request.resource.data.down >= 0;
    }

    match /admin_alerts/{alertId} {
      allow read: if false;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /friend_requests/{requestId} {
      allow read: if isSignedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.status == 'pending';
      allow update: if isSignedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}